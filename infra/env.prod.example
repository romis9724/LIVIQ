# LIVIQ 배포 env 계약 예시 — infra/compose.prod.yml 용 (ADR-0020 / docs/06 §7)
#
# 이 파일에는 **placeholder만** 있다. 실제 값은 절대 커밋하지 않는다.
#   로컬 스모크:  cp infra/env.prod.example infra/env.prod   # infra/env.prod 는 VCS 미추적
#   운영:         install -m 0600 infra/env.prod.example /etc/liviq/env.prod  # 레포 밖 · 0600
#                 + 파일 안 ENV_FILE 도 같은 절대경로로 지정
#
# 사용법: `docker compose --env-file <이 파일> -f infra/compose.prod.yml --profile <tier> up -d`
#   - `--env-file` = compose 파일의 `${...}` 치환 소스
#   - `env_file:`  = api·ai-worker·migrate 컨테이너에 주입되는 런타임 env (같은 파일)
#
# 표기: [로컬] = 1호스트 스모크용 값 · [운영] = 반드시 바꿀 값
# tier 최소 배치(docs/06 §7): PII_MASTER_KEY·DATABASE_URL·SMTP_* 는 **app tier 파일에만** 둔다.
#   data tier 파일엔 POSTGRES_*·MINIO_ROOT_*·NEO4J_PASSWORD 만, web tier 파일엔 ②만 있으면 된다.

# ─────────────────────────────────────────────────────────────────
# ① 이미지 · 태그
# ─────────────────────────────────────────────────────────────────
# [로컬] liviq → liviq-api:local 등 로컬 빌드 이미지
# [운영] ghcr.io/<owner>/liviq → ghcr.io/<owner>/liviq-api:<git-sha>
IMAGE_PREFIX=liviq
# [운영] 커밋 sha 로 핀 고정(롤백 = 이전 sha 재기동). `latest` 금지(docs/09 §2.1)
IMAGE_TAG=local
# 레포 밖 env 파일을 쓸 때만 절대경로로 바꾼다. [운영] /etc/liviq/env.prod
ENV_FILE=./env.prod

# ─────────────────────────────────────────────────────────────────
# ② tier 배선 (바인드 주소 · 프록시 · 업스트림)
# ─────────────────────────────────────────────────────────────────
# 데이터 서비스 포트 바인드 주소. 0.0.0.0 금지(docs/06 §6.1).
# [운영] data VM의 **프라이빗 IP** — 예: 10.0.0.20
DATA_BIND=127.0.0.1
# api 포트 바인드 주소. [운영] app VM의 프라이빗 IP — 예: 10.0.0.30
APP_BIND=127.0.0.1

# Caddy 호스트 포트. [로컬] 8080/8443(80·443 선점 회피) · [운영] 80 / 443
CADDY_HTTP=8080
CADDY_HTTPS=8443

# 사이트 주소. 스킴 http = 자동 TLS 없음(로컬).
# [운영] 스킴 없이 실도메인 → Caddy 자동 HTTPS: RESIDENT_SITE=liviq.example.com
RESIDENT_SITE=http://resident.localhost
ADMIN_SITE=http://admin.localhost

# Caddy 업스트림. [로컬] 같은 compose 네트워크의 컨테이너명
# [운영 web tier] API_UPSTREAM=10.0.0.30:8000 (app VM)
API_UPSTREAM=api:8000
RESIDENT_UPSTREAM=web-resident:3000
ADMIN_UPSTREAM=web-admin:3001

# ─────────────────────────────────────────────────────────────────
# ③ 데이터 서비스 자격증명 (data tier)
# ─────────────────────────────────────────────────────────────────
POSTGRES_USER=liviq
POSTGRES_PASSWORD=change-me-postgres # [운영] 강한 무작위 값
POSTGRES_DB=liviq

# 미지정 시 MinIO가 기본 자격증명(minioadmin)으로 기동한다 — 반드시 지정.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password # [운영] 강한 무작위 값

# neo4j 사용자는 이미지 초기화상 `neo4j` 고정(8자 이상 비밀번호 요구).
NEO4J_PASSWORD=change-me-neo4j
# 한 VM에 데이터 서비스 4종이 공존 → JVM 힙·페이지캐시 상한을 명시(기본값은 호스트 메모리 비례로 과대).
NEO4J_HEAP=512m
NEO4J_PAGECACHE=512m

# ─────────────────────────────────────────────────────────────────
# ④ api 필수 env (apps/api/app/config.py — 기본값 없음 = 누락 시 기동 실패)
# ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# pii_vault 봉투 암호화 마스터 키(KEK) — 32byte base64. 생성: openssl rand -base64 32
# ★ 유실 = pii_vault 복호 불능. 시크릿 매니저 + 오프라인 백업 이중화(docs/06 §7).
PII_MASTER_KEY=REPLACE_WITH_BASE64_32BYTES
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=change-me-minio-user # MINIO_ROOT_USER 와 동일 값(또는 전용 서비스 계정)
S3_SECRET_ACCESS_KEY=change-me-minio-password # MINIO_ROOT_PASSWORD 와 동일 값
S3_BUCKET=liviq

# 세션 쿠키 Secure 플래그 스위치(apps/api/app/deps.py).
# [로컬] local — HTTP 스모크에서 Secure 쿠키를 피해야 로그인이 된다
# [운영] production — TLS 전제(비-local 이면 Secure 부여)
API_ENV=local

# 선택(기본값 있음) — 필요 시만 조정. docs/08 가드레일.
# RATE_LIMIT_USER_PER_MIN=10
# RATE_LIMIT_TENANT_PER_MIN=100
# CACHE_TTL_S=3600
# LLM_DAILY_TOKEN_BUDGET=0
# STORAGE_BACKEND=s3

# 프록시 경유 **퍼블릭** URL — 이메일 검증·초대 링크의 목적지다(내부 주소 금지).
# [로컬] CADDY_HTTP=8080 기준 · [운영] https://liviq.example.com 등 실도메인
API_BASE_URL=http://resident.localhost:8080/api
WEB_BASE_URL=http://resident.localhost:8080
WEB_ADMIN_BASE_URL=http://admin.localhost:8080
# same-origin /api 프록시라 CORS는 실질적으로 쓰이지 않지만, 값은 사이트 오리진과 맞춰 둔다.
WEB_ORIGINS=http://resident.localhost:8080,http://admin.localhost:8080

# ─────────────────────────────────────────────────────────────────
# ⑤ DB (packages/db — liviq_db.config)
# ─────────────────────────────────────────────────────────────────
# asyncpg 스킴 필수. 호스트는 data tier — [로컬] postgres(컨테이너명) · [운영] 10.0.0.20
#
# ★ 미해결 보안 갭 (실배포 전 필수 — docs/09 §8.3 백로그 "런타임 RLS 우회 롤")
#   아래 `liviq`는 postgres 이미지가 만드는 **superuser(BYPASSRLS)** 다. 런타임이 이 롤로
#   붙으면 RLS 정책이 걸려 있어도 무조건 통과해 절대 규칙 3의 "DB RLS 이중 방어" 중
#   두 번째 층이 비활성이 된다(실측: tenant 컨텍스트 없이 households 322행 반환).
#   마이그레이션이 만드는 런타임 롤 `liviq_app`(BYPASSRLS 없음)이 정답이나, 현재
#   그 롤은 NOLOGIN·비밀번호 없음이라 접속에 쓸 수 없다 → 값만 바꾸면 앱이 기동 실패한다.
#   전용 접속 롤 부여 + owner/런타임 URL 분리는 **별도 작업 단위**에서 처리한다.
DATABASE_URL=postgresql+asyncpg://liviq:change-me-postgres@postgres:5432/liviq

# ─────────────────────────────────────────────────────────────────
# ⑥ LLM · 임베딩 · 그래프 (packages/ai-core — AiCoreSettings · GraphSettings)
# ─────────────────────────────────────────────────────────────────
# LLM은 컨테이너 밖 외부 엔드포인트다(ADR-0005·0020 결정 6). base_url + /chat/completions 로 호출.
# [로컬] 호스트에서 도는 Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.1:8b
# LLM_API_KEY=  # OpenAI 호환 게이트웨이가 요구할 때만
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TIMEOUT_S=60

# 임베딩은 bge-m3(1024) 고정 — 모델 변경 = 전량 재색인 이벤트(docs/03 §8).
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=

# Neo4j(시설 파생 그래프). 호스트는 data tier — [운영] bolt://10.0.0.20:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# 비밀번호는 ③의 NEO4J_PASSWORD 와 같은 값을 적는다(그래프 클라이언트는 이 키를 읽는다).
NEO4J_PASSWORD=change-me-neo4j

# ─────────────────────────────────────────────────────────────────
# ⑦ 메일 (SMTP — ADR-0014 이메일 검증·초대)
# ─────────────────────────────────────────────────────────────────
# [로컬] console — 링크를 api 로그로 출력(SMTP 불필요) · [운영] smtp
MAIL_BACKEND=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# SMTP_FROM=noreply@example.com

# ─────────────────────────────────────────────────────────────────
# ⑧ 웹 빌드 인자 (NEXT_PUBLIC_* — **빌드타임 인라인**)
# ─────────────────────────────────────────────────────────────────
# 런타임 env로는 바꿀 수 없다. 값을 바꾸면 웹 이미지를 **재빌드**해야 한다.
# /api 상대경로 고정이면 환경별 재빌드가 필요 없다(ADR-0020 결정 4).
NEXT_PUBLIC_API_BASE_URL=/api
# VWorld 실사 3D 프론트 키(H9-3). 도메인 잠금 키라 번들 노출이 유출은 아니다(docs/06 §7 예외).
# 이 파일엔 placeholder만 — 실제 키는 운영 env 파일에.
NEXT_PUBLIC_VWORLD_API_KEY=REPLACE_WITH_VWORLD_KEY
