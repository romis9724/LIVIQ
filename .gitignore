# dependencies
node_modules/
.pnpm-store/

# build outputs
.next/
.next-build/
out/
dist/
.turbo/

# python cache
__pycache__/
*.pyc

# ts build info
*.tsbuildinfo

# vercel (machine/account-specific project links)
.vercel/

# env / secrets
.env
.env.*
!.env.example
# 배포 env 파일 — 점 없는 이름이라 위 .env.* 패턴에 걸리지 않는다(infra/env.prod.example만 커밋)
infra/env.prod
infra/env.prod.*
!infra/env.prod.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# test / coverage
coverage/
playwright-report/
test-results/
tests/e2e/.auth/
tests/e2e/.visual-sweep/

# secrets / credentials (절대 커밋 금지)
mcp/service-credential.json
mcp/tokens.json
**/service-credential.json
**/tokens.json
*.pem
*.key

# 시크릿 포함 아카이브 (service-credential.json·tokens.json 동봉)
mcp/apt_mng_agent.zip

# 테스트 아티팩트
.coverage

# 로컬 문서 (신청서 등 — 커밋 대상 아님)
_local/

# 검증·리포트 생성 산출물 (fixture는 evals/fixtures에 커밋, 산출물은 재생성 대상)
outputs/

# 데모 문서 PDF (scripts/generate_demo_docs.py 산출물 — 콘텐츠 원본만 커밋)
apps/api/scripts/data/generated_docs/
